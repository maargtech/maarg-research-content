{"type":"doc","attrs":{},"content":[{"type":"heading","attrs":{"textAlign":"center","level":2},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}},{"type":"italic","attrs":{}}],"text":"Why we started Maarg Technologies,and why India's roads deserve to think."}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":null,"text":"You know the moment."}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":null,"text":"Your light is red. The road crossing in front of you is completely empty. Not a scooter, not an auto, not a stray dog. Just a green light glowing for nobody, while forty of you sit in a knot of horns and heat, watching the countdown like it owes you money."}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":null,"text":"That signal isn't broken. It's doing exactly what it was told to do, years ago, by a timing plan that has no idea you exist."}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"That is the problem. And that is why we exist."}],"marks":null,"text":null},{"type":"image","attrs":{"src":"/media/uploads/ast_5042a12ecb50468a.webp","alt":null,"title":null,"width":null,"height":null,"assetId":"ast_5042a12ecb50468a","caption":null},"content":null,"marks":null,"text":null},{"type":"heading","attrs":{"textAlign":null,"level":2},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"Millions of journeys, a few thousand junctions"}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":null,"text":"Ambulances, school buses, delivery riders, a family of four on one bike. All of it funnels through junctions still run by fixed timers that cannot see, count or react."}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":null,"text":"Congestion in just four Indian metros is estimated to cost "},{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"more than ₹1.4 lakh crore every year"},{"type":"text","attrs":{},"content":null,"marks":null,"text":" (BCG). India ranks "},{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"#5 in the world for congestion"},{"type":"text","attrs":{},"content":null,"marks":null,"text":" (TomTom, 2025). Behind those numbers are wasted fuel, dirtier air and ambulances crawling through traffic that could have been cleared for them."}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":null,"text":"Our roads have cameras. They have signals. What they don't have is a brain that connects the two. So we decided to build one."}],"marks":null,"text":null},{"type":"heading","attrs":{"textAlign":null,"level":2},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"Maarg means path"}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":null,"text":"मार्ग. Path. Direction. The way from one place to another."}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"Maarg Technologies is a technology company first."},{"type":"text","attrs":{},"content":null,"marks":null,"text":" We build AI and hardware systems for the infrastructure people use every day, and we are starting with traffic because nowhere is the need more visible. Our mission is to make everyday infrastructure "},{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"safer, faster and fairer"},{"type":"text","attrs":{},"content":null,"marks":null,"text":", in cities where roads respond to people "},{"type":"text","attrs":{},"content":null,"marks":[{"type":"italic","attrs":{}}],"text":"as things happen"},{"type":"text","attrs":{},"content":null,"marks":null,"text":", not months later."}],"marks":null,"text":null},{"type":"heading","attrs":{"textAlign":null,"level":2},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"What we're building: MAARG Intelligence"}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":null,"text":"Our flagship product ties signals, cameras, sensors, message boards and operators into one system that can actually think."}],"marks":null,"text":null},{"type":"bulletList","attrs":{},"content":[{"type":"listItem","attrs":{},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"Signals that look upstream."},{"type":"text","attrs":{},"content":null,"marks":null,"text":" MAARG sees the wave of vehicles coming and stretches or shortens the green to match, always within strict safety limits."}],"marks":null,"text":null}],"marks":null,"text":null},{"type":"listItem","attrs":{},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"Green corridors on autopilot."},{"type":"text","attrs":{},"content":null,"marks":null,"text":" Detect the ambulance, predict when it reaches each junction, and clear the way ahead. Never all-green. Never a gamble with safety."}],"marks":null,"text":null}],"marks":null,"text":null},{"type":"listItem","attrs":{},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"Incident detection and commuter information."},{"type":"text","attrs":{},"content":null,"marks":null,"text":" Jams and incidents flagged as they happen, and pushed to message boards, apps and navigation."}],"marks":null,"text":null}],"marks":null,"text":null},{"type":"listItem","attrs":{},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"One command view."},{"type":"text","attrs":{},"content":null,"marks":null,"text":" Every junction on one screen, built on open standards and open APIs."}],"marks":null,"text":null}],"marks":null,"text":null}],"marks":null,"text":null},{"type":"image","attrs":{"src":"/media/uploads/ast_16a19d70ddb84a3b.webp","alt":null,"title":null,"width":null,"height":null,"assetId":"ast_16a19d70ddb84a3b","caption":null},"content":null,"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":null,"text":"And the video stays at the junction. Edge AI processes the feed locally and sends up only tiny structured observations: faster decisions, less bandwidth, and privacy by design."}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":null,"text":"We are building for "},{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"Indian streets"},{"type":"text","attrs":{},"content":null,"marks":null,"text":": dense, mixed traffic, rain, dust, night, power cuts and patchy networks. If it can't survive a Tuesday evening at an Indian junction, it isn't done."}],"marks":null,"text":null},{"type":"image","attrs":{"src":"/media/uploads/ast_f8f351f366524a5a.webp","alt":null,"title":null,"width":null,"height":null,"assetId":"ast_f8f351f366524a5a","caption":null},"content":null,"marks":null,"text":null},{"type":"heading","attrs":{"textAlign":null,"level":2},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"Bold about the destination. Honest about the road."}],"marks":null,"text":null},{"type":"bulletList","attrs":{},"content":[{"type":"listItem","attrs":{},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"Now:"},{"type":"text","attrs":{},"content":null,"marks":null,"text":" building MAARG Intelligence, from simulation and signal control to computer vision and the operations platform."}],"marks":null,"text":null}],"marks":null,"text":null},{"type":"listItem","attrs":{},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"Next:"},{"type":"text","attrs":{},"content":null,"marks":null,"text":" our first pilot corridors with city and police partners."}],"marks":null,"text":null}],"marks":null,"text":null},{"type":"listItem","attrs":{},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"Later:"},{"type":"text","attrs":{},"content":null,"marks":null,"text":" city-scale rollouts, and applied AI beyond traffic."}],"marks":null,"text":null}],"marks":null,"text":null}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":null,"text":"We will always say clearly what is built, what is in pilot and what is only planned. No software should change a live signal until it has earned that right. Ours will run in shadow mode first, behind a hardware safety layer, alongside the people who already run the roads."}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"The four signs we steer by"}],"marks":null,"text":null},{"type":"bulletList","attrs":{},"content":[{"type":"listItem","attrs":{},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"code","attrs":{}}],"text":"Measurable progress."},{"type":"text","attrs":{},"content":null,"marks":null,"text":" Success criteria first. Defensible results only."}],"marks":null,"text":null}],"marks":null,"text":null},{"type":"listItem","attrs":{},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"code","attrs":{}}],"text":"Safety before speed."},{"type":"text","attrs":{},"content":null,"marks":null,"text":" Designed around failure, privacy and human oversight."}],"marks":null,"text":null}],"marks":null,"text":null},{"type":"listItem","attrs":{},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"code","attrs":{}}],"text":"Direction over hype."},{"type":"text","attrs":{},"content":null,"marks":null,"text":" Built, piloted and planned are three different words."}],"marks":null,"text":null}],"marks":null,"text":null},{"type":"listItem","attrs":{},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"code","attrs":{}}],"text":"Built to coordinate."},{"type":"text","attrs":{},"content":null,"marks":null,"text":" Open standards, existing equipment, real partnership."}],"marks":null,"text":null}],"marks":null,"text":null}],"marks":null,"text":null},{"type":"blockquote","attrs":{},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":null,"text":"\"That signal isn't broken. It's doing exactly what it was told to do, years ago, by a timing plan that has no idea you exist.\""}],"marks":null,"text":null}],"marks":null,"text":null},{"type":"heading","attrs":{"textAlign":null,"level":2},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"Come build the road ahead with us"}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":null,"text":"If you run a city, a traffic police unit, a command centre or an ambulance network: "},{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"tell us where your city gets stuck."},{"type":"text","attrs":{},"content":null,"marks":null,"text":" If you are an engineer who gets excited by a smarter red light: we should talk."}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":null,"text":"And if you have ever sat at a red light staring at an empty road, wondering why: we hear you. We're on it."}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"bold","attrs":{}}],"text":"Maarg Technologies. Intelligence for the roads ahead."}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":"center"},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"link","attrs":{"href":"mailto:contact@maargtechnologies.in","target":"_blank","rel":"noopener noreferrer","class":null,"title":null}},{"type":"bold","attrs":{}}],"text":"contact@maargtechnologies.in"}],"marks":null,"text":null},{"type":"blockquote","attrs":{},"content":[{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"text","attrs":{},"content":null,"marks":[{"type":"italic","attrs":{}}],"text":"\"Our roads have cameras. They have signals. What they don't have is a brain that connects the two.\""}],"marks":null,"text":null}],"marks":null,"text":null},{"type":"paragraph","attrs":{"textAlign":null},"content":[{"type":"hardBreak","attrs":{},"content":null,"marks":null,"text":null}],"marks":null,"text":null}],"marks":null,"text":null}